Options -MultiViews
RewriteEngine On
RewriteBase /

# ================== 1. FIX SEO SPAM (สำคัญมาก ห้ามลบ!) ==================
# สั่ง Google ไม่ให้ Index หน้าที่มีพารามิเตอร์ขยะ (แก้กราฟพุ่ง)
<IfModule mod_headers.c>
    RewriteCond %{QUERY_STRING} (color|ram_|year_|ssd_|sort|price|filter) [NC]
    RewriteRule .* - [E=MY_NOINDEX:1]
    Header set X-Robots-Tag "noindex, follow" env=MY_NOINDEX
</IfModule>

# ================== 2. SITEMAP ==================
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ================== 3. ย้ายหน้าเก่า (301 Redirect) ==================
# .php URLs เก่า → โครงสร้างใหม่
Redirect 301 /articles.php /articles/
Redirect 301 /article-detail.php /articles/
Redirect 301 /works.php /works/
Redirect 301 /work-detail.php /works/
Redirect 301 /warranty.php /warranty/
Redirect 301 /buyback.php /buyback/
Redirect 301 /en/articles.php /en/articles/
Redirect 301 /en/article-detail.php /en/articles/
Redirect 301 /en/works.php /en/works/
Redirect 301 /en/work-detail.php /en/works/
Redirect 301 /en/warranty.php /en/warranty/
Redirect 301 /en/buyback.php /en/buyback/


Redirect 301 /imac.php /services/imac.php
Redirect 301 /airpods.php /services/airpods.php
Redirect 301 /apple-watch.php /services/apple-watch.php
Redirect 301 /software.php /services/software.php
Redirect 301 /macbook.php /services/macbook.php
Redirect 301 /iphone.php /services/iphone.php
Redirect 301 /ipad.php /services/ipad.php

# ย้ายเครื่องมือเทส
Redirect 301 /test/mic.php /tester/microphone-tester/
Redirect 301 /test/camera.php /tester/camera-tester/
Redirect 301 /test/sound.php /tester/sounds-tester/
Redirect 301 /test/keyboard.php /tester/keyboard-tester/
Redirect 301 /test/screen.php /tester/touchscreen-tester/
Redirect 301 /device-test/ /tester/

# ================== 4. URL สวย (Internal Rewrite) ==================
# แปลงจาก /article/slug ให้ Server ไปอ่านไฟล์จริง (แต่ URL ข้างบนไม่เปลี่ยน)

# บทความ
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^article/([\w-]+)/?$ /articles/detail.php?slug=$1 [L,QSA]
RewriteRule ^en/article/([\w-]+)/?$ /en/articles/detail.php?slug=$1 [L,QSA]

# เปลี่ยน /product/slug เก่าไปที่ shop (301 สำหรับ SEO)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^product/([\w-]+)/?$ /shop [R=301,L]
RewriteRule ^en/product/([\w-]+)/?$ /en/shop [R=301,L]

# ผลงาน
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^work/([\w-]+)/?$ /works/detail.php?slug=$1 [L,QSA]
RewriteRule ^en/work/([\w-]+)/?$ /en/works/detail.php?slug=$1 [L,QSA]

# ================== 5. ซ่อนนามสกุล .php ==================
# ถ้าเข้า /work แล้วไม่เจอโฟลเดอร์ ให้ลองเรียก work.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [L]