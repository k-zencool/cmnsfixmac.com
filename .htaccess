Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# ══════════════════════════════════════════════════════════════
# PHP UPLOAD LIMITS
# ══════════════════════════════════════════════════════════════
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size       60M
    php_value memory_limit        256M
</IfModule>

# ══════════════════════════════════════════════════════════════
# 1. HTTPS REDIRECT (production only — skip localhost + LAN dev access)
# ══════════════════════════════════════════════════════════════
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
# skip private LAN ranges + *.local so other devices on the WiFi can browse over http
RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
RewriteCond %{HTTP_HOST} !^10\. [NC]
RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[01])\. [NC]
RewriteCond %{HTTP_HOST} !\.local(:|$) [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Canonical host: force www → non-www (matches every page's <link rel="canonical">)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ══════════════════════════════════════════════════════════════
# 2. PROTECT SENSITIVE FILES
# ══════════════════════════════════════════════════════════════
<FilesMatch "(\.env|composer\.(json|lock)|CLAUDE\.md|check_db\.php)$">
    Require all denied
</FilesMatch>

# ══════════════════════════════════════════════════════════════
# 3. SECURITY HEADERS
# ══════════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ══════════════════════════════════════════════════════════════
# 4. SEO — noindex pages with spam/filter query params
# ══════════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    SetEnvIf Query_String "(color|ram_|year_|ssd_|sort|price|filter)" NOINDEX_PAGE
    Header set X-Robots-Tag "noindex, follow" env=NOINDEX_PAGE
</IfModule>

# ══════════════════════════════════════════════════════════════
# 5. COMPRESSION
# ══════════════════════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml application/xml
</IfModule>

# ══════════════════════════════════════════════════════════════
# 6. BROWSER CACHING
# CSS/JS: no-cache on localhost (dev), long-cache on production
# Images/fonts: always long-cache (use ?v= busting on CSS/JS)
# ══════════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    SetEnvIf Host "localhost"    DEV_HOST
    SetEnvIf Host "127\.0\.0\.1" DEV_HOST

    # localhost: ไม่ cache ทุกอย่าง (HTML + CSS + JS)
    Header always set Cache-Control "no-cache, no-store, must-revalidate" env=DEV_HOST
    Header always set Pragma "no-cache"                                    env=DEV_HOST
    Header always set Expires "0"                                          env=DEV_HOST

    # production: long-cache รูปและ font, medium-cache CSS/JS
    <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable" env=!DEV_HOST
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000" env=!DEV_HOST
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ══════════════════════════════════════════════════════════════
# 7. 301 REDIRECTS — old URLs → new structure
# ══════════════════════════════════════════════════════════════

# Pages restructured to directories (TH)
Redirect 301 /articles.php          /articles/
Redirect 301 /article-detail.php    /articles/
Redirect 301 /works.php             /works/
Redirect 301 /work-detail.php       /works/
Redirect 301 /warranty.php          /warranty/
Redirect 301 /buyback.php           /buyback/

# Pages restructured to directories (EN)
Redirect 301 /en/articles.php       /en/articles/
Redirect 301 /en/article-detail.php /en/articles/
Redirect 301 /en/works.php          /en/works/
Redirect 301 /en/work-detail.php    /en/works/
Redirect 301 /en/warranty.php       /en/warranty/
Redirect 301 /en/buyback.php        /en/buyback/

# Services (root → /services/{device}/)
Redirect 301 /macbook.php           /services/macbook/
Redirect 301 /iphone.php            /services/iphone/
Redirect 301 /ipad.php              /services/ipad/
Redirect 301 /imac.php              /services/imac/
Redirect 301 /airpods.php           /services/airpods/
Redirect 301 /apple-watch.php       /services/apple-watch/
Redirect 301 /software.php          /services/software/

# Services (.php → directory)
Redirect 301 /services/macbook.php      /services/macbook/
Redirect 301 /services/imac.php         /services/imac/
Redirect 301 /services/iphone.php       /services/iphone/
Redirect 301 /services/ipad.php         /services/ipad/
Redirect 301 /services/apple-watch.php  /services/apple-watch/
Redirect 301 /services/airpods.php      /services/airpods/
Redirect 301 /services/software.php     /services/software/

# EN Services (.php → directory)
Redirect 301 /en/services/macbook.php      /en/services/macbook/
Redirect 301 /en/services/imac.php         /en/services/imac/
Redirect 301 /en/services/iphone.php       /en/services/iphone/
Redirect 301 /en/services/ipad.php         /en/services/ipad/
Redirect 301 /en/services/apple-watch.php  /en/services/apple-watch/
Redirect 301 /en/services/airpods.php      /en/services/airpods/
Redirect 301 /en/services/software.php     /en/services/software/

# Testers (เดิม /test/ → /tester/)
Redirect 301 /test/mic.php          /tester/microphone-tester/
Redirect 301 /test/camera.php       /tester/camera-tester/
Redirect 301 /test/sound.php        /tester/sounds-tester/
Redirect 301 /test/keyboard.php     /tester/keyboard-tester/
Redirect 301 /test/screen.php       /tester/touchscreen-tester/
Redirect 301 /device-test/          /tester/

# ══════════════════════════════════════════════════════════════
# 8. URL REWRITES
# ══════════════════════════════════════════════════════════════

# sitemap.xml
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /article/slug → articles/detail.php (TH) — [^/]+ to allow Thai/unicode slugs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^article/([^/]+)/?$ /articles/detail.php?slug=$1 [L,QSA]

# /en/article/slug → en/articles/detail.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/article/([^/]+)/?$ /en/articles/detail.php?slug=$1 [L,QSA]

# /work/slug → works/detail.php (TH)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^work/([^/]+)/?$ /works/detail.php?slug=$1 [L,QSA]

# /en/work/slug → en/works/detail.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/work/([^/]+)/?$ /en/works/detail.php?slug=$1 [L,QSA]

# /product/slug (ระบบเก่า) → /shop
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^product/([\w-]+)/?$ /shop/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/product/([\w-]+)/?$ /en/shop/ [R=301,L]
